          <div className="flex items-center gap-2 flex-1 min-w-48 rounded-xl px-3 py-2.5" style={{ background: "#f8fafc", border: "1.5px solid #e2e8f0" }}>
            <Search className="w-4 h-4" style={{ color: "#94a3b8" }} />
